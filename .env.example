# AppealMyTickets.com — Environment Variables
# Copy this to .env.local and fill in real values when ready

# Supabase (database + auth)
NEXT_PUBLIC_SUPABASE_URL=PASTE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
DATABASE_URL=PASTE_POSTGRES_CONNECTION_STRING_HERE

# Email (Resend preferred, SendGrid fallback)
RESEND_API_KEY=PASTE_KEY_HERE
SENDGRID_API_KEY=PASTE_KEY_HERE
EMAIL_FROM=info@appealmytickets.com

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=PASTE_TOKEN_HERE
HUBSPOT_FORM_ID=PASTE_FORM_ID_HERE
HUBSPOT_PIPELINE_ID=PASTE_PIPELINE_ID_HERE
HUBSPOT_DEAL_STAGE_ID=PASTE_STAGE_ID_HERE

# Twilio SMS
TWILIO_ACCOUNT_SID=PASTE_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=PASTE_NUMBER_HERE
FOUNDER_ALERT_PHONE=9493508804

# Square Payments (required for production)
SQUARE_ACCESS_TOKEN=PASTE_SQUARE_ACCESS_TOKEN_HERE
SQUARE_LOCATION_ID=PASTE_SQUARE_LOCATION_ID_HERE
SQUARE_ENV=sandbox  # Change to 'production' for live payments
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Your app's public URL (for Square redirect)

# Cloudflare Turnstile — rotate the formerly committed secret before deployment
NEXT_PUBLIC_TURNSTILE_SITE_KEY=PASTE_PUBLIC_SITE_KEY_HERE
TURNSTILE_SECRET_KEY=PASTE_NEW_SECRET_KEY_HERE

# Random server-only bearer secret; hosting cron must send Authorization: Bearer <secret>
CRON_SECRET=PASTE_RANDOM_SECRET_HERE

# Square webhook (separate sandbox and production values)
SQUARE_WEBHOOK_SIGNATURE_KEY=PASTE_SIGNATURE_KEY_HERE
SQUARE_WEBHOOK_URL=https://www.appealmytickets.com/api/payment/webhook

# Do not override NODE_ENV in hosted deployments; Next sets it appropriately.
# Demo screens are simulations only and cannot authenticate production users.
